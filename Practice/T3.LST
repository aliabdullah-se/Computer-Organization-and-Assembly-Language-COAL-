     1                                  [org 0x0100]
     2 00000000 B80000                  mov ax, 0 ; initialzes the ax with 0
     3                                  
     4                                  ;using ax for the word size 2 bytes 16 bits
     5                                  
     6 00000003 0306[3300]              add ax, [num1] ;added 0 + 1 = 1 so ax = 1
     7 00000007 0306[3500]              add ax, [num1 + 2] ;added 1 + 2 = 3 so ax = 3
     8 0000000B 0306[3700]              add ax, [num1 + 4] ;added 3 + 3 = 6 so ax = 6
     9 0000000F 0306[3900]              add ax, [num1 + 6] ;added 6 + 4 = 10 so ax = 10
    10                                  
    11                                  ;using bx = bh + bl for the word size 2 bytes 16 bits
    12                                  
    13 00000013 8A1E[3B00]              mov bl, [num2] ; moved the number safely in lower bit 0010 
    14 00000017 B700                    mov bh, 0 ;initialzes the bh register as 0 so it is cleared manually
    15 00000019 021E[3C00]              add bl, [num2 + 1] ;added the 10 + 11 = 21 in the bl lower bytes of bx register
    16 0000001D B700                    mov bh, 0 ;initialzes the bh register as 0 so it is cleared manually
    17 0000001F 021E[3D00]              add bl, [num2 + 2] ;added the 21 + 5 = 26 in bl the lower bytes of bx register
    18 00000023 B700                    mov bh, 0 ;initialzes the bh register as 0 so it is cleared manually
    19 00000025 021E[3E00]              add bl, [num2 + 3] ;added the 26 + 6 = 32 in bl the lower byte of bx register
    20                                  
    21                                  ; Finally accumalution of the sum as the ax, bx registers
    22                                  
    23 00000029 01D8                    add ax, bx ; accumulation of the sum in ax register 
    24                                  
    25                                  ; Incrementing the sum variable 
    26                                  
    27 0000002B A3[3F00]                mov [sum], ax ; now the sum variable has the accumulated sum of all the numbers 
    28                                  
    29 0000002E B8004C                  mov ax, 0x4c00 ; Program Termination
    30 00000031 CD21                    int 0x21
    31                                  
    32 00000033 0100020003000400        num1: dw 1, 2, 3, 4
    33 0000003B 0A0B0506                num2: db 10, 11, 5, 6
    34 0000003F 0000                    sum: dw 0
